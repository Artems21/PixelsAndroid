<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:background="#353535">

    <ImageView
        android:id="@+id/creator_image_view"
        android:layout_width="411dp"
        android:layout_height="276dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.102"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageButton
        android:id="@+id/select_photo_button"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="23dp"
        android:backgroundTint="#00FFFFFF"
        android:hapticFeedbackEnabled="false"
        android:scaleType="centerInside"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_slider"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/camera_icon_circle_21" />


    <ImageButton
        android:id="@+id/random_effect_button"
        android:layout_width="81dp"
        android:layout_height="81dp"
        android:layout_marginTop="43dp"
        android:backgroundTint="#00FFFFFF"
        android:hapticFeedbackEnabled="false"
        android:scaleType="centerInside"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.951"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_slider"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/random" />

    <ImageButton
        android:id="@+id/save_button"
        android:layout_width="81dp"
        android:layout_height="81dp"
        android:layout_marginTop="43dp"
        android:backgroundTint="#00FFFFFF"
        android:hapticFeedbackEnabled="false"
        android:scaleType="centerInside"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.048"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_slider"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/saveicon" />

    <com.google.android.material.slider.Slider
        android:id="@+id/value_slider"
        android:layout_width="393dp"
        android:layout_height="52dp"
        android:stepSize="0.0025"
        android:value="0.5"
        android:valueFrom="0"
        android:valueTo="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.444"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.551"
        app:thumbColor="#990031"
        app:thumbElevation="4dp"
        app:thumbStrokeColor="#870C0C"
        app:thumbStrokeWidth="2dp"

        app:trackColor="#000000"
        app:trackHeight="4dp" />

    <Spinner
        android:id="@+id/effects_spinner"
        android:layout_width="250dp"
        android:layout_height="38dp"
        android:layout_marginTop="106dp"
        android:background="@drawable/spinner_background"
        android:padding="8dp"
        android:spinnerMode="dialog"
        android:textColor="#BABABA"
        app:layout_constraintBottom_toBottomOf="@+id/select_photo_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.02" />

    <Spinner
        android:id="@+id/resolution_spinner"
        android:layout_width="250dp"
        android:layout_height="38dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/spinner_background"
        android:padding="8dp"
        android:spinnerMode="dialog"
        android:textSize="16sp"
        android:tooltipText="Max Sizes"
        app:layout_constraintBottom_toBottomOf="@+id/select_photo_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/back_res_button"
        android:layout_width="57dp"
        android:layout_height="48dp"
        android:layout_marginTop="47dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&lt;&lt;"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toEndOf="@id/resolution_spinner"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/back_effect_button"
        android:layout_width="57dp"
        android:layout_height="48dp"
        android:layout_marginTop="106dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&lt;&lt;"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toEndOf="@+id/effects_spinner"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/next_res_button"
        android:layout_width="57dp"
        android:layout_height="48dp"
        android:layout_marginTop="47dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&gt;&gt;"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toEndOf="@+id/resolution_spinner"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/goto_main_button"
        android:layout_width="41dp"
        android:layout_height="47dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&gt;"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/creator_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/next_effect_button"
        android:layout_width="57dp"
        android:layout_height="48dp"
        android:layout_marginTop="106dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&gt;&gt;"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toEndOf="@+id/effects_spinner"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>