<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/creator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    tools:context=".EffectCreatorActivity"
    android:background="#353535">

    <Spinner
        android:id="@+id/algorithm_spinner"
        android:layout_width="200dp"
        android:layout_height="38dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="155dp"
        android:background="@drawable/spinner_background"
        android:padding="8dp"
        android:spinnerMode="dialog"
        android:textSize="16sp"
        android:tooltipText="Max Sizes"
        app:layout_constraintBottom_toBottomOf="@+id/select_photo_button"
        app:layout_constraintEnd_toEndOf="@+id/name_edit_text"
        app:layout_constraintHorizontal_bias="0.225"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />

    <Spinner
        android:id="@+id/colors_spinner"
        android:layout_width="200dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="155dp"
        android:background="@drawable/spinner_background"
        android:padding="8dp"
        android:spinnerMode="dialog"
        android:textSize="16sp"
        android:tooltipText="Max Sizes"
        app:layout_constraintBottom_toBottomOf="@+id/select_photo_button"
        app:layout_constraintEnd_toEndOf="@+id/name_edit_text"
        app:layout_constraintHorizontal_bias="0.225"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/algorithm_spinner"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/creator_image_view"
        android:layout_width="411dp"
        android:layout_height="276dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.102"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageButton
        android:id="@+id/select_photo_button"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="9dp"
        android:backgroundTint="#00FFFFFF"
        android:hapticFeedbackEnabled="false"
        android:scaleType="centerInside"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.196"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_creator_slider"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/camera_icon_circle_21" />

    <ImageButton
        android:id="@+id/save_effect_button"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="9dp"
        android:backgroundTint="#009D9696"
        android:hapticFeedbackEnabled="false"
        android:scaleType="centerInside"
        android:scaleX="3"
        android:scaleY="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.771"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_creator_slider"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_input_add" />

    <Button
        android:id="@+id/goto_main_button"
        android:layout_width="41dp"
        android:layout_height="47dp"
        android:backgroundTint="#200854"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="&lt;"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/creator_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/add_color_button"
        android:layout_width="41dp"
        android:layout_height="47dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#39AD0F"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="+"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.827"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_edit_text"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/color_picker_button"
        android:layout_width="41dp"
        android:layout_height="47dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#FFFFFF"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.691"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_edit_text"
        app:layout_constraintVertical_bias="0" />

    <Button
        android:id="@+id/remove_color_button"
        android:layout_width="41dp"
        android:layout_height="47dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#9D0808"
        android:drawablePadding="4dp"
        android:elevation="8dp"
        android:padding="8dp"
        android:text="-"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.956"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_edit_text"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.slider.Slider
        android:id="@+id/value_creator_slider"
        android:layout_width="393dp"
        android:layout_height="52dp"
        android:stepSize="0.0025"
        android:value="0.5"
        android:valueFrom="0"
        android:valueTo="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.444"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.635"
        app:thumbColor="#990031"
        app:thumbElevation="4dp"
        app:thumbStrokeColor="#870C0C"
        app:thumbStrokeWidth="2dp"

        app:trackColor="#000000"
        app:trackHeight="4dp" />

    <EditText
        android:id="@+id/name_edit_text"
        android:layout_width="124dp"
        android:layout_height="38dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/border_edit_text"
        android:ems="10"
        android:inputType="text"
        android:padding="6dp"
        android:text="Effect name"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.965"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/creator_image_view"
        app:layout_constraintVertical_bias="0.0" />


</androidx.constraintlayout.widget.ConstraintLayout>